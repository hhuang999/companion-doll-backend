  "cards": [
    {
      "dot": "cyan",
      "title": "六处集成补丁",
      "items": [
        "LLM provider 取得共享核心；Memory provider 通知结束；ASR 工具保留原始情绪与事件；receiveAudio 登记并绕过旧 chat/TTS。",
        "abortHandle 独立通知取消；listenMessageHandler 明确标记 wake。idle_end 也显式传入控制类型，避免把控制提示当作用户话语。"
      ]
    },
    {
      "dot": "violet",
      "title": "线程与协程分工",
      "items": [
        "handle_input 在连接事件循环运行，用 asyncio.to_thread 调 on_input；回复生成交给 conn.executor。",
        "OutputPort 在连接的 asyncio loop 维护 Queue / worker / active task；跨线程提交用 call_soon_threadsafe，音频发送和取消都回到该循环。"
      ]
    },
    {
      "dot": "amber",
      "title": "缓存与动态合成",
      "items": [
        "固定开场、危机和练习音频需提前准备；启动时核对缓存，固定计划不会在危机接管时现场合成。",
        "cache_key 取模型、声音和文本的 SHA-256；普通文本优先读缓存，未命中才调用 TTS。动态 WAV 仅暂存用于转码，编码后删除。"
      ]
    },
    {
      "dot": "emerald",
      "title": "练习是播放计划",
      "items": [
        "PlaybackPlan 含 script_id、segments、start_index；每段可携带 pause_s、audio_path、audio_duration_s。",
        "练习按已测 WAV 时长加停顿再次校验不超过 90 s；segment 回执更新续播索引。中断后续播仍需重新同意。"
      ]
    },
    {
      "dot": "rose",
      "title": "取消与迟到音频",
      "items": [
        "generation 在核心、新事件入队、worker 取队和编码后分别检查；旧 TTS 即使晚返回也不能重新开始播放。",
        "取消先提高 minimum，撤销 active task，并串行等待 stop_task；Transport 停发送控制器、清队列并发送 tts stop。"
      ]
    },
    {
      "dot": "slate",
      "title": "回执的含义",
      "items": [
        "started 激活提议并标记跟进已询问；completed 推进开场、收尾或练习状态；failed / cancelled 做提议与计划清理。",
        "completed 当前来自服务端节流发送完成估计，尚无设备实际播完 ACK；真机扬声器停声延迟仍需验收。"
      ]
    }
  ]
