  "cards": [
    {
      "dot": "cyan",
      "title": "12 张物理表的归属",
      "items": [
        "会话域：users、sessions、turns、outputs。策略域：snapshots、reasoner_runs、card_usage。记忆域：profile、events、followups。",
        "风险域：risk_events。任务域：end_tasks。图按使用职责合并部分表；每个数据库节点的源码链接包含真实 SQL 定义。"
      ]
    },
    {
      "dot": "violet",
      "title": "主键、外键与幂等",
      "items": [
        "sessions.user_key → users；turns.session_id → sessions；outputs 的 session_id / turn_id 分别引用 sessions / turns。",
        "turns 以 (session_id,input_id) 去重；outputs 用 output_id；snapshots 用 (session_id,version)；card_usage 用 (action_id,outcome) 去重。"
      ]
    },
    {
      "dot": "emerald",
      "title": "记忆如何写入",
      "items": [
        "profile 按 (user_key,field) 更新，较旧 source_turn_id 不覆盖新事实。events 按用户、摘要、来源集合去重。",
        "followups 按用户、内容、到期日去重；后续结果写回 result 并标 resolved。所有模型记忆在 Validator 检查 source_turn_ids 后才提交。"
      ]
    },
    {
      "dot": "cyan",
      "title": "记忆如何进入对话",
      "items": [
        "core_memory 取资料摘要前 120 字、重要性最高的 3 个 active 事件、最多 2 个到期 pending 跟进及最近会话总结。",
        "Talker 使用序列化记忆的前 450 字；history 默认最近 10 个用户轮次，Reasoner 使用 12 个。当前没有向量数据库或 embedding 检索。"
      ]
    },
    {
      "dot": "amber",
      "title": "跟进与播放回执闭环",
      "items": [
        "开场按重要性预留一条到期项：pending → reserved。真正 started 后才置 asked；尚未开始就失败、取消或进程恢复会释放预留。",
        "预留关系记录 reservation_session_id；用户回答后的 followup_results 仍需要来源轮次验证。"
      ]
    },
    {
      "dot": "rose",
      "title": "会话结束与持久任务",
      "items": [
        "active → ending 时先固定 final_turn_id 并写 end_tasks；分析成功同事务更新 summary / closed / done / reasoner_runs。",
        "重启取消残留输出，将未结束会话转 ending 并排队 pending end。失败任务保留 last_error 和 attempt_count，由 retry_end 显式重试。"
      ]
    },
    {
      "dot": "slate",
      "title": "并发与清除数据",
      "items": [
        "SQLite 开启 WAL 和 foreign_keys，每线程连接、5 s busy_timeout；Store 用进程内 RLock 串行短写事务，默认一个后端进程持有数据库。",
        "purge_user 先标 purging、结束会话并等风险与 Reasoner 回调退出，再删除该用户所有关联数据，避免后台结果重新写回。"
      ]
    }
  ]
}
