  "cards": [
    {
      "dot": "cyan",
      "title": "三个独立状态维度",
      "items": [
        "stage：opening → explore / comfort → permission → action → closing / quiet；转换受规则与当前状态约束。",
        "mode：normal / exercise / crisis。lifecycle：active / ending / closed。进入危机切换 mode，结束会话切换 lifecycle。"
      ]
    },
    {
      "dot": "emerald",
      "title": "许可是一个具体对象",
      "items": [
        "PendingOffer 记录 offer_id、kind、target_id、topic_revision、offered_turn_id 和 offered_user_index。创建时 active=false。",
        "只有绑定该 offer_id 的输出收到 started 回执，提议才激活；明确同意随后才能进入等待卡片或练习。"
      ]
    },
    {
      "dot": "amber",
      "title": "等待与失效",
      "items": [
        "提议默认可跨 2 个用户轮次。明确同意后保留 accepted_at / accepted_user_index，等待上限 30 s，用户轮次差超过 2 也失效。",
        "换题、拒绝会清理提议；行动提议遇哭声、纠正或高情绪强度也失效。每次输入检查期限，没有独立到期计时器自动执行行动。"
      ]
    },
    {
      "dot": "violet",
      "title": "卡片分为策略与表达两部分",
      "items": [
        "Card.reasoner 提供 when_any、not_when、success、exit；Card.talker 提供 steps、examples、never_say。targets / constraints / limits 限制适用范围。",
        "Validator 先审查模型候选卡，StateMachine.eligible 再按当前会话筛选；优先选 preferred，若不可用则选首张合格卡。"
      ]
    },
    {
      "dot": "rose",
      "title": "后台建议不能直接进入 action",
      "items": [
        "Q_TRANSITIONS 允许 explore → comfort、comfort → permission、action → closing，以及指定阶段退回 explore。",
        "action 的入口由明确同意 + 合格卡片决定；行动输出成功提交后才增加 action_turns，card_usage 用 action_id/outcome 去重。"
      ]
    },
    {
      "dot": "cyan",
      "title": "退出与续播",
      "items": [
        "行动中拒绝、纠正或哭声退回 explore；拒绝可把正在使用的卡记入 cards_refused。",
        "练习被打断保存 resume_script_id / resume_index。下一次续播仍要提出 resume_exercise 提议并取得同意。"
      ]
    }
  ]
}
