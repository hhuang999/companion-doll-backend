  "cards": [
    {
      "dot": "cyan",
      "title": "实时路径",
      "items": [
        "输入控制、记忆检索和策略筛选均在本地；Talker 不等待后台 Future。",
        "未核对新增输入的策略退为非行动倾听；当前已确认行动继续由许可状态机管理。"
      ]
    },
    {
      "dot": "rose",
      "title": "安全与许可",
      "items": [
        "high 由独立检测器决定，迟到结果仍可撤销普通输出并提交固定危机音频。",
        "Agent 不能授予许可；提议必须对应 started，明确同意且卡片合格才能行动。"
      ]
    },
    {
      "dot": "emerald",
      "title": "工程范围",
      "items": [
        "六类策略、三种短练习用于合成案例与成年成员课程演示；内容哈希、逐项验收和音频绑定控制 demo 准入。",
        "单 Python 模块化进程、一个库一个 Core；图中模块是代码职责，不是微服务。",
        "点击源码可查看 GitHub 固定提交依据；v1 图集保留为历史入口。"
      ]
    }
  ]
