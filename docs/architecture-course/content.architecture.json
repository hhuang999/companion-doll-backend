  "cards": [
    {
      "dot": "cyan",
      "title": "研究的实际承接",
      "items": [
        "核查研究对象、方法及外推限制，再设计短步骤；不把完整干预的效果归给一句话。",
        "启用目录提供适用、排除、最少信息、反例、停止条件与来源，过滤后才进入 Planner。"
      ]
    },
    {
      "dot": "rose",
      "title": "控制与表达分工",
      "items": [
        "当前状态机决定邀请、同意和撤回；Agent 候选不授予行动许可。",
        "Talker只执行当前一步，固定练习另走有时长上限的音频计划；安全通路独立。"
      ]
    },
    {
      "dot": "emerald",
      "title": "反馈改变什么",
      "items": [
        "服务器 completed 只证明执行。明确反馈关联实际输出、支持版本与步骤。",
        "同会话无效反馈停止该支持；长期经验保留上下文，不从一次反馈推导永久偏好。"
      ]
    }
  ]
