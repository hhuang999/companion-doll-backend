  "cards": [
    {
      "dot": "emerald",
      "title": "范围与纠正",
      "items": [
        "turn / topic / session / until_time / persistent 分别解析；“今天”按配置时区次日零点到期。",
        "局部 allow/revoke 记录独立保存，范围结束后长期限制仍在。",
        "新来源更正生成 supersedes 链；旧来源、伪造来源和过期依赖不能覆盖当前事实。"
      ]
    },
    {
      "dot": "amber",
      "title": "主动提及与反馈",
      "items": [
        "敏感记忆及 only_when_raised / avoid_proactive 受原话相关性与当前边界约束。",
        "server completed 只是执行证据，不能形成“有帮助”；模糊“挺好”不自动绑定方法偏好。",
        "同一可归因策略/提议在四轮内两次明确失败才标 repeated_failure。"
      ]
    },
    {
      "dot": "rose",
      "title": "持久化边界",
      "items": [
        "迁移未知高版本 fail fast；v1 未核验来源标 legacy_unverified，不作为确认记忆。",
        "重启打断普通协作，结束业务从 end_tasks 恢复；失败显式 retry，新记录关联 retry_of。",
        "清除等待失败保留屏障，不假报删除；备份与外部 API 数据生命周期另行管理。"
      ]
    }
  ]
